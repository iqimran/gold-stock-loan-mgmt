# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://..., SESSION_SECURE_COOKIE=true,
# LOG_LEVEL=info, a strong DB_PASSWORD and ADMIN_PASSWORD. Validate with `php artisan app:check-environment`.
# See docs/deployment.md.
APP_NAME="Gold Stock & Loan Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Business date policy: "today", due dates and the 00:05 interest run use this time zone (e.g. Asia/Dhaka).
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs/CIDRs, or *). Empty = none.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Days of files kept by the "daily" log channel (docker-compose.prod.yml logs to daily,stderr).
# LOG_DAILY_DAYS=14

# PostgreSQL (16+ recommended). Docker: DB_* are set by docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gold_loan
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production over HTTPS: send the session cookie only over TLS.
# SESSION_SECURE_COOKIE=true

# API tokens expire after this many minutes (30 days).
SANCTUM_TOKEN_EXPIRATION=43200

BROADCAST_CONNECTION=log
# Uploaded customer images and the shop logo are stored on the private "local" disk (storage/app/private):
# keep storage/ on persistent storage and include it in backups.
FILESYSTEM_DISK=local
# Nothing is queued today; a worker is only needed if queued jobs/notifications are added.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial administrator created by `php artisan db:seed`.
# ADMIN_PASSWORD is required outside local/testing environments.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Defaults until a value is saved in Settings (Settings → Loan settings wins).
# Consecutive missed interest periods that raise an alert.
ALERT_MISSED_PERIOD_THRESHOLD=2
CURRENCY_CODE=BDT
CURRENCY_SYMBOL="৳"
GRACE_DAYS=0

# Interest engine (config/loans.php). Changing these affects NEW loans' interest method; read the comments
# in config/loans.php first.
# INTEREST_BASE=outstanding            # outstanding | principal
# INTEREST_DUE=period_end              # period_end | period_start
# INTEREST_YEARLY_CONVERSION=twelfths  # twelfths | actual_days

# PDF/Excel exports run in the request; above this many rows the user is asked to narrow the filters.
EXPORT_MAX_ROWS=5000

# Printed on payment receipts until a value is saved in Settings.
SHOP_NAME="${APP_NAME}"
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_RECEIPT_FOOTER="Thank you. Please keep this receipt."

# Docker development (docker compose up -d): app on http://localhost:8080,
# PostgreSQL on 127.0.0.1:55432 (loopback only).
# APP_PORT=8080
# FORWARD_DB_PORT=55432
# Match your host user so bind-mounted files stay editable: UID=$(id -u) GID=$(id -g)
# UID=1000
# GID=1000
# DOCKER_DB_DATABASE=gold_loan
# DOCKER_DB_USERNAME=gold_loan
# DOCKER_DB_PASSWORD=secret

# Docker production (docker-compose.prod.yml): DB_* above are used for the bundled PostgreSQL
# (DB_HOST is set to "pgsql" by the compose file).
# RUN_MIGRATIONS=true   # the app container runs `php artisan migrate --force` on start
# APP_IMAGE_TAG=latest

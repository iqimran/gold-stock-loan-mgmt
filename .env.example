APP_NAME="Gold Stock & Loan Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs/CIDRs, or *). Empty = none.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (16+ recommended). Docker: DB_* are set by docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gold_loan
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production over HTTPS: send the session cookie only over TLS.
# SESSION_SECURE_COOKIE=true

# API tokens expire after this many minutes (30 days).
SANCTUM_TOKEN_EXPIRATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial administrator created by `php artisan db:seed`.
# ADMIN_PASSWORD is required outside local/testing environments.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Consecutive missed interest periods that raise an alert (until the Settings module manages it).
ALERT_MISSED_PERIOD_THRESHOLD=2

# Printed on payment receipts until the Settings module manages shop details.
SHOP_NAME="${APP_NAME}"
SHOP_ADDRESS=
SHOP_PHONE=
SHOP_RECEIPT_FOOTER="Thank you. Please keep this receipt."

# Docker development (docker compose up -d): app on http://localhost:8080,
# PostgreSQL on 127.0.0.1:55432 (loopback only).
# APP_PORT=8080
# FORWARD_DB_PORT=55432
# Match your host user so bind-mounted files stay editable: UID=$(id -u) GID=$(id -g)
# UID=1000
# GID=1000
# DOCKER_DB_DATABASE=gold_loan
# DOCKER_DB_USERNAME=gold_loan
# DOCKER_DB_PASSWORD=secret
